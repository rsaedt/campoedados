# Ambiente
CAMPOEDADOS_ENV=development

# Banco
# Desenvolvimento local:
DATABASE_URL=sqlite:///./campoedados.db
# Homologação Render + Supabase:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
MIGRATION_DATABASE_URL=
CAMPOEDADOS_DB_POOL_SIZE=5
CAMPOEDADOS_DB_MAX_OVERFLOW=2
CAMPOEDADOS_DB_POOL_TIMEOUT=15
CAMPOEDADOS_DB_POOL_RECYCLE=1800
CAMPOEDADOS_DB_NULL_POOL=false

# OpenAI
OPENAI_API_KEY=
CAMPOEDADOS_OPENAI_VISION_MODEL=gpt-5-mini
CAMPOEDADOS_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Arquivos originais recebidos do campo
CAMPOEDADOS_MEDIA_STORAGE=filesystem
CAMPOEDADOS_UPLOAD_DIR=var/data/uploads
CAMPOEDADOS_MAX_UPLOAD_BYTES=20971520
# Homologação: use bucket PRIVADO no Supabase Storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CAMPOEDADOS_SUPABASE_STORAGE_BUCKET=campoedados-staging-media

# Compatibilidade temporária com ambientes antigos apenas:
# SUPABASE_SERVICE_ROLE_KEY=

# Credenciais de canais por cliente
CAMPOEDADOS_CREDENTIAL_ENCRYPTION_KEY=

# WhatsApp Cloud API — opcional, somente quando o número oficial Campo & Dados for ativado.
CAMPOEDADOS_WHATSAPP_ACCESS_TOKEN=
CAMPOEDADOS_WHATSAPP_PHONE_NUMBER_ID=
CAMPOEDADOS_WHATSAPP_APP_SECRET=
CAMPOEDADOS_WHATSAPP_VERIFY_TOKEN=
CAMPOEDADOS_WHATSAPP_GRAPH_VERSION=

# Telegram
# Tokens de bots NÃO ficam em ENV. Cada conta/bot é cadastrada no banco em channel_accounts.
