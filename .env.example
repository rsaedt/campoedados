# Ambiente
CAMPOEDADOS_ENV=development

# Banco
# Desenvolvimento local:
DATABASE_URL=sqlite:///./campoedados.db
# Homologação Render + Supabase:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# MIGRATION_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
MIGRATION_DATABASE_URL=
CAMPOEDADOS_DB_POOL_SIZE=5
CAMPOEDADOS_DB_MAX_OVERFLOW=2
CAMPOEDADOS_DB_POOL_TIMEOUT=15
CAMPOEDADOS_DB_POOL_RECYCLE=1800
# Use true se DATABASE_URL apontar para pooler em transaction mode (porta 6543).
CAMPOEDADOS_DB_NULL_POOL=false

# OpenAI
OPENAI_API_KEY=
CAMPOEDADOS_OPENAI_VISION_MODEL=gpt-5-mini
CAMPOEDADOS_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Arquivos originais recebidos do campo
CAMPOEDADOS_MEDIA_STORAGE=filesystem
CAMPOEDADOS_UPLOAD_DIR=var/data/uploads
CAMPOEDADOS_MAX_UPLOAD_BYTES=20971520
# Homologação: use bucket PRIVADO no Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CAMPOEDADOS_SUPABASE_STORAGE_BUCKET=campoedados-staging-media

# Bootstrap idempotente do primeiro ambiente de homologação
CAMPOEDADOS_BOOTSTRAP_ENABLED=false
CAMPOEDADOS_BOOTSTRAP_ORG_NAME=
CAMPOEDADOS_BOOTSTRAP_ORG_SLUG=
CAMPOEDADOS_BOOTSTRAP_ADMIN_NAME=
CAMPOEDADOS_BOOTSTRAP_ADMIN_EMAIL=
CAMPOEDADOS_BOOTSTRAP_ADMIN_TOKEN=
# Ex.: [{"code":"SH7","name":"SH7"},{"code":"NSG","name":"NSG"}]
CAMPOEDADOS_BOOTSTRAP_UNITS_JSON=[]
# Informe qualquer combinação dos módulos: livestock,feed_mill,finance
CAMPOEDADOS_BOOTSTRAP_MODULES=
# Opcional. Ex.: [{"channel":"telegram","account_key":"default","external_user_id":"123","default_unit_code":"SH7"}]
CAMPOEDADOS_BOOTSTRAP_CHANNEL_IDENTITIES_JSON=[]

# WhatsApp Cloud API
CAMPOEDADOS_WHATSAPP_ACCESS_TOKEN=
CAMPOEDADOS_WHATSAPP_PHONE_NUMBER_ID=
CAMPOEDADOS_WHATSAPP_APP_SECRET=
CAMPOEDADOS_WHATSAPP_VERIFY_TOKEN=
# Informe explicitamente a versão ativa da Graph API no seu app Meta.
CAMPOEDADOS_WHATSAPP_GRAPH_VERSION=

# Telegram
# Modo simples (rota /v1/channels/webhooks/telegram/default)
CAMPOEDADOS_TELEGRAM_BOT_TOKEN=
CAMPOEDADOS_TELEGRAM_SECRET_TOKEN=
# Múltiplos bots: {"fazenda-a":{"token":"...","secret_token":"..."}, "fazenda-b":{"token":"...","secret_token":"..."}}
CAMPOEDADOS_TELEGRAM_BOTS_JSON=
